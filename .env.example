# Copia este archivo como .env para cambiar la configuración. No hay secretos.
# npm start lo carga si existe (node --env-file-if-exists).

# Puerto local (entero de 1024 a 65535).
# PORT=3000

# Interfaz de escucha: solo 127.0.0.1 o ::1. Con cualquier otro valor la aplicación no arranca.
# HOST=127.0.0.1

# Formato de los logs de la consola: texto (legible) o json (una línea JSON por evento).
# LOG_FORMATO=texto

# Nivel de los logs: error, warn, info o debug.
# LOG_NIVEL=info

# Umbrales de duplicados entre fuentes (ADR-0004): segundos, km y diferencia de magnitud.
# Números mayores que 0 (máximos: 600 s, 1000 km y 5).
# DEDUP_DT_S=30
# DEDUP_DD_KM=100
# DEDUP_DM=1.0

# Magnitud mínima de la carga inicial y de la consulta periódica (todas, 1.0, 2.0, 2.5, 3.0,
# 4.0, 4.5 o 5.0). Si la página pide menos, el servidor consulta lo que falta.
# INGESTA_MAG_MIN=2.0

# Cadencia de la consulta periódica por zona, en segundos (RNF-10: como mínimo 30 y 60).
# EMSC_FDSN_INTERVALO_S=30
# USGS_INTERVALO_S=60

# Tiempo límite de cada petición a una fuente, en ms (1000-15000).
# FUENTE_TIMEOUT_MS=10000

# Días de sismos que se guardan en memoria (1-30).
# RETENCION_DIAS=30

# si: consulta EMSC y USGS. no: arranca sin consultar ninguna fuente (pruebas o trabajo sin red).
# FUENTES_ACTIVAS=si

# Ventana de aviso, en minutos (entero de 5 a 1440; PRD E4): un sismo del stream es
# «notificable» si su hora de origen es de hace como mucho este tiempo al emitirlo.
# AVISO_VENTANA_MIN=60

# Máximo de conexiones en vivo (SSE) simultáneas (entero de 1 a 16; AM-13). La siguiente
# recibe 503 con Retry-After: 10.
# SSE_MAX_CLIENTES=8
