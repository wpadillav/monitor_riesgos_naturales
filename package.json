{
  "name": "monitor-riesgos-naturales",
  "version": "2.0.0",
  "private": true,
  "description": "Monitor de Riesgos Naturales: sismos en tiempo real para España, Colombia y Panamá (servidor local).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <27"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "zonas": "node scripts/generar-zonas.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm test && npm run audit:prod",
    "sbom": "npm sbom --sbom-format cyclonedx --omit=dev > sbom.cdx.json",
    "api:lint": "redocly lint --config docs/api/redocly.yaml docs/api/openapi.yaml"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/point-to-polygon-distance": "7.4.0",
    "hono": "4.13.13",
    "leaflet": "1.9.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@redocly/cli": "2.62.1",
    "@turf/bbox": "7.4.0",
    "@turf/buffer": "7.4.0",
    "@turf/difference": "7.4.0",
    "@turf/simplify": "7.4.0",
    "eslint": "10.12.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
